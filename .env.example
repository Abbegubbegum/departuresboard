WIFI_SSID=your-wifi-ssid
WIFI_PASSWORD=your-wifi-password

# https://developer.vasttrafik.se/apis/13/v4 - client credentials from your app on developer.vasttrafik.se
VASTTRAFIK_CLIENT_ID=your-client-id
VASTTRAFIK_CLIENT_SECRET=your-client-secret

# Leave VASTTRAFIK_STOP_ID empty and set VASTTRAFIK_STOP_NAME to search by
# name on boot - the firmware will print matching stop-area gids to Serial.
# Once you have the gid, put it in VASTTRAFIK_STOP_ID and it'll fetch
# departures directly from then on.
VASTTRAFIK_STOP_ID=
VASTTRAFIK_STOP_NAME=your-stop-name
